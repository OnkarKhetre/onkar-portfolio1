package com.dba.controller;

import java.io.IOException;
import java.util.List;

import com.dba.config.DatabaseRegistry;
import com.dba.models.TableConfig;
import com.dba.service.TableGrowthService;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;

@WebServlet("/tableconfig")
public class TableConfigServlet extends HttpServlet {
    
    private static final long serialVersionUID = 1L;
    
    private TableGrowthService service = new TableGrowthService();

    // --------------------------------------------------------
    // GET: Loads the page and displays the current tables
    // --------------------------------------------------------
    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {

        if (!isLoggedIn(request)) {
            
            response.sendRedirect(request.getContextPath() + "/login.jsp");
            return;
            
        }

        loadPageData(request);
        
        request.getRequestDispatcher("/tableconfig.jsp").forward(request, response);
        
    }

    // --------------------------------------------------------
    // POST: Handles the form submission to add a new table
    // --------------------------------------------------------
    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {

        if (!isLoggedIn(request)) {
            
            response.sendRedirect(request.getContextPath() + "/login.jsp");
            return;
            
        }

        String site = request.getParameter("site");
        
        String target = request.getParameter("target");
        
        String tableName = request.getParameter("tableName");

        try {
            
            if (site == null || site.trim().isEmpty() || target == null || target.trim().isEmpty()) {
                throw new Exception("Please select a database.");
            }
            
            if (tableName == null || tableName.trim().isEmpty()) {
                throw new Exception("Please enter a valid table name.");
            }

            // Save the new table to MySQL
            service.addTableToConfig(site, target, tableName.trim());
            
            request.setAttribute("successMsg", "Table " + tableName.toUpperCase() + " successfully added to tracking!");

        } catch (Exception e) {
            
            e.printStackTrace();
            request.setAttribute("errorMsg", e.getMessage());
            
        }

        // Reload the lists to show the newly added table
        loadPageData(request);
        
        request.getRequestDispatcher("/tableconfig.jsp").forward(request, response);
    }

    // --------------------------------------------------------
    // Helper method to load dropdowns and tracked tables list
    // --------------------------------------------------------
    private void loadPageData(HttpServletRequest request) {
        
        try {
            
            List<TableConfig> trackedTables = service.getAllConfiguredTables();
            
            request.setAttribute("trackedTables", trackedTables);
            
        } catch (Exception e) {
            
            e.printStackTrace();
            request.setAttribute("errorMsg", "Failed to load tracked tables: " + e.getMessage());
            
        }
        
        request.setAttribute("dbList", DatabaseRegistry.ALL_DATABASES);
        
    }

    private boolean isLoggedIn(HttpServletRequest request) {
        
        HttpSession session = request.getSession(false);
        
        if (session == null) {
            return false;
        }
        
        return session.getAttribute("loggedUser") != null;
        
    }
}
