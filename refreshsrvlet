package sbi.prod;

import java.io.*;
import java.nio.file.Files;
import java.nio.file.StandardCopyOption;
import java.util.*;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.MultipartConfig;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.Part;

@WebServlet("/ReportGeneratorServlet")
@MultipartConfig(maxFileSize = 10485760) // 10MB limit
public class ReportGeneratorServlet extends HttpServlet {

    protected void doPost(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
        
        File tempExcel = null;
        File tempDoc = null;
        
        try {
            // 1. Save the uploaded Book1.xlsx to a temporary server file
            Part filePart = request.getPart("excelData");
            tempExcel = File.createTempFile("uploaded_excel_", ".xlsx");
            try (InputStream input = filePart.getInputStream()) {
                Files.copy(input, tempExcel.toPath(), StandardCopyOption.REPLACE_EXISTING);
            }

            // 2. Read the blank Template from the hidden WEB-INF folder to a temporary working file
            tempDoc = File.createTempFile("working_report_", ".docx");
            try (InputStream templateStream = getServletContext().getResourceAsStream("/WEB-INF/Daily_Report_Template.docx")) {
                if (templateStream == null) {
                    throw new FileNotFoundException("Template not found. Make sure Daily_Report_Template.docx is inside the WEB-INF folder!");
                }
                Files.copy(templateStream, tempDoc.toPath(), StandardCopyOption.REPLACE_EXISTING);
            }

            // 3. These strings replace your old E:\\ hardcoded paths!
            String excelpath = tempExcel.getAbsolutePath();
            String file_path = tempDoc.getAbsolutePath();

            // ==============================================================================
            // 4. YOUR BUSINESS LOGIC GOES HERE
            // Paste EVERYTHING from inside your old performreportgeneration() method here.
            // 
            // NOTE: Do NOT copy your old "String excelpath=..." or "String file_path=..." lines.
            // We already defined them right above this block!
            // ==============================================================================
            
            /* 
               Example of your pasted code:
               Map<String, String> gen5 = new HashMap<>();
               
               // ... your excelservice logic reading from 'excelpath' ...
               // ... your databaseservice config and calls ...
               // ... your graphservice call generating 'graphpath' ...
               
               // At the very end of your pasted code, call update and pass file_path as the FIRST parameter!
               reportorigin.update(file_path, graphpath, volsummary, dbsize1, dbsize2, dbsize3, db1tbs, db2tbs, db3tbs, db4tbs, db5tbs, db6tbs, user1, user2, user3, user4, db1backup, db2backup, db1arch, db2arch, diskspace1, diskspace2);
            */

            // ==============================================================================

            // 5. Stream the successfully updated document back to the user's browser as a download
            response.setContentType("application/vnd.openxmlformats-officedocument.wordprocessingml.document");
            response.setHeader("Content-Disposition", "attachment; filename=\"Daily_Report_Completed.docx\"");
            
            try (InputStream docIn = new FileInputStream(tempDoc);
                 OutputStream out = response.getOutputStream()) {
                byte[] buffer = new byte[8192];
                int bytesRead;
                while ((bytesRead = docIn.read(buffer)) != -1) {
                    out.write(buffer, 0, bytesRead);
                }
            }

        } catch (Exception e) {
            // If anything fails, print the exact error to the browser screen for debugging
            e.printStackTrace();
            response.setContentType("text/html");
            response.getWriter().println("<h3>Error Generating Report:</h3><pre>" + e.getMessage() + "</pre>");
        } finally {
            // 6. Housekeeping: Delete the temporary files so the Tomcat server doesn't fill up
            if (tempExcel != null && tempExcel.exists()) tempExcel.delete();
            if (tempDoc != null && tempDoc.exists()) tempDoc.delete();
        }
    }
}
