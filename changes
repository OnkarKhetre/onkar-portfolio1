    // --------------------------------------------------------
    // METHOD 2: For the Dashboard Graph (With Date Range)
    // --------------------------------------------------------
    public List<TableGrowth> getHistoricalGrowth(String site, String targetDb, String tableName, String startDate, String endDate) {
        
        List<TableGrowth> historyList = new ArrayList<TableGrowth>();
        Connection mysqlConn = null;
        PreparedStatement ps = null;
        ResultSet rs = null;

        try {
            mysqlConn = databaseconnection.getMysqlConnection();
            
            // Replaced the LIMIT with a dynamic date range BETWEEN clause
            String sql = 
                "SELECT size_mb, recorded_date " +
                "FROM tracked_table_growth " +
                "WHERE site = ? AND target_db = ? AND table_name = ? " +
                "AND recorded_date BETWEEN ? AND ? " +
                "ORDER BY recorded_date ASC";

            ps = mysqlConn.prepareStatement(sql);
            ps.setString(1, site);
            ps.setString(2, targetDb);
            ps.setString(3, tableName.toUpperCase());
            ps.setString(4, startDate);
            ps.setString(5, endDate);

            rs = ps.executeQuery();

            while (rs.next()) {
                TableGrowth growth = new TableGrowth();
                growth.setSite(site);
                growth.setTargetDb(targetDb);
                growth.setTableName(tableName);
                growth.setSizeMb(rs.getDouble("size_mb"));
                growth.setRecordedDate(rs.getString("recorded_date"));
                
                historyList.add(growth);
            }

        } catch (Exception e) {
            e.printStackTrace();
        } finally {
            if (rs != null) try { rs.close(); } catch (Exception e) {}
            if (ps != null) try { ps.close(); } catch (Exception e) {}
            if (mysqlConn != null) try { databaseconnection.closeconnection(mysqlConn); } catch (Exception e) {}
        }

        return historyList;
    }
