        // --- NEW TIME-SYNC LOGIC ---
        
        LocalDateTime now = LocalDateTime.now();
        
        // Target execution time: 23:55 (11:55 PM) every night
        LocalDateTime nextRun = now.with(LocalTime.of(23, 55, 0));
        
        // If Tomcat is restarted AFTER 11:55 PM today, push the first run to tomorrow
        if (now.compareTo(nextRun) >= 0) {
            nextRun = nextRun.plusDays(1);
        }
        
        // Calculate exactly how many minutes are left until 11:55 PM
        long initialDelayInMinutes = ChronoUnit.MINUTES.between(now, nextRun);
        
        System.out.println("Scheduler synced. Next table size capture will run in " + initialDelayInMinutes + " minutes.");

        // Wait the exact calculated delay for the first run, then run exactly every 1440 minutes (24 hours)
        scheduler.scheduleAtFixedRate(captureTask, initialDelayInMinutes, 1440, TimeUnit.MINUTES);
