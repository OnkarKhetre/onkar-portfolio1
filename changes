// Add this import at the top of your Servlet
import java.time.LocalDate;

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {

        if (!isLoggedIn(request)) {
            response.sendRedirect(request.getContextPath() + "/login.jsp");
            return;
        }

        String site = request.getParameter("site");
        if (site != null) site = site.trim();
        
        String target = request.getParameter("target");
        if (target != null) target = target.trim();
        
        String tableName = request.getParameter("tableName");
        if (tableName != null) tableName = tableName.trim();
        
        String run = request.getParameter("run");
        
        // Grab dates from UI, or default to the last 30 days
        String startDate = request.getParameter("startDate");
        String endDate = request.getParameter("endDate");
        
        if (startDate == null || startDate.isEmpty()) {
            startDate = LocalDate.now().minusDays(30).toString();
        }
        if (endDate == null || endDate.isEmpty()) {
            endDate = LocalDate.now().toString();
        }

        StringBuilder chartLabels = new StringBuilder();
        StringBuilder chartData = new StringBuilder();
        
        String totalIncrementStr = "0.00 TB";
        String statusColor = "#22d3ee"; // Default cyan

        try {
            // Fetch dropdown data
            List<TableConfig> trackedTables = service.getAllConfiguredTables();
            request.setAttribute("trackedTables", trackedTables);

            if ("Y".equalsIgnoreCase(run)) {
                
                if (site == null || target == null || tableName == null) {
                    throw new Exception("Please select a valid database and table.");
                }

                // Pass the dates to our updated Service method
                List<TableGrowth> history = service.getHistoricalGrowth(site, target, tableName, startDate, endDate);

                if (history.isEmpty()) {
                    throw new Exception("No data found for " + tableName + " between " + startDate + " and " + endDate);
                }

                double firstSizeTb = 0;
                double lastSizeTb = 0;

                for (int i = 0; i < history.size(); i++) {
                    
                    // Convert MB to TB (1 TB = 1024 * 1024 MB)
                    double sizeTb = history.get(i).getSizeMb() / 1048576.0;
                    
                    if (i == 0) firstSizeTb = sizeTb;
                    if (i == history.size() - 1) lastSizeTb = sizeTb;

                    chartLabels.append("'").append(history.get(i).getRecordedDate()).append("'");
                    // Format to 4 decimal places for TB precision
                    chartData.append(String.format("%.4f", sizeTb));

                    if (i < history.size() - 1) {
                        chartLabels.append(",");
                        chartData.append(",");
                    }
                }
                
                // Calculate the total increment
                double increment = lastSizeTb - firstSizeTb;
                
                // Add a '+' sign if it grew, and change color based on growth
                if (increment > 0) {
                    totalIncrementStr = "+" + String.format("%.4f", increment) + " TB";
                    statusColor = "#f43f5e"; // Red if growing
                } else if (increment < 0) {
                    totalIncrementStr = String.format("%.4f", increment) + " TB";
                    statusColor = "#10b981"; // Green if shrinking
                } else {
                    totalIncrementStr = "0.0000 TB (No Change)";
                }
            }

        } catch (Exception e) {
            e.printStackTrace();
            request.setAttribute("errorMsg", e.getMessage());
        }

        request.setAttribute("site", site);
        request.setAttribute("target", target);
        request.setAttribute("tableName", tableName);
        request.setAttribute("startDate", startDate);
        request.setAttribute("endDate", endDate);
        request.setAttribute("run", run);
        request.setAttribute("chartLabels", chartLabels.toString());
        request.setAttribute("chartData", chartData.toString());
        request.setAttribute("incrementStr", totalIncrementStr);
        request.setAttribute("statusColor", statusColor);
        request.setAttribute("dbList", DatabaseRegistry.ALL_DATABASES);

        request.getRequestDispatcher("/tablegrowth.jsp").forward(request, response);
    }
