            // Query Oracle DBA_SEGMENTS for exact MB size (Includes Partitions & LOBs)
            String oracleSql = 
                "SELECT " +
                "    t_name AS segment_name, " +
                "    ROUND(SUM(bytes)/1024/1024, 2) AS size_mb " +
                "FROM ( " +
                "    SELECT segment_name AS t_name, bytes " +
                "    FROM dba_segments " +
                "    WHERE segment_name IN (" + placeholders.toString() + ") " +
                "    UNION ALL " +
                "    SELECT l.table_name AS t_name, s.bytes " +
                "    FROM dba_lobs l " +
                "    JOIN dba_segments s ON l.segment_name = s.segment_name " +
                "    WHERE l.table_name IN (" + placeholders.toString() + ") " +
                ") " +
                "GROUP BY t_name";

            oraclePs = oracleConn.prepareStatement(oracleSql);
            
            // Because we use the IN clause twice (once for tables, once for LOBs), 
            // we have to set the parameters twice in the PreparedStatement.
            int totalTables = tableNames.size();
            for (int i = 0; i < totalTables; i++) {
                String tName = tableNames.get(i).toUpperCase();
                
                // Set parameters for the first IN clause (Base Tables & Partitions)
                oraclePs.setString(i + 1, tName);
                
                // Set parameters for the second IN clause (LOB Segments)
                oraclePs.setString(i + 1 + totalTables, tName);
            }

            oracleRs = oraclePs.executeQuery();
