package com.dba.config;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.Executors;
import java.util.concurrent.ScheduledExecutorService;
import java.util.concurrent.TimeUnit;

import com.dba.connection.databaseconnection;
import com.dba.service.TableGrowthService;

import jakarta.servlet.ServletContextEvent;
import jakarta.servlet.ServletContextListener;
import jakarta.servlet.annotation.WebListener;

@WebListener
public class TableGrowthScheduler implements ServletContextListener {

    private ScheduledExecutorService scheduler;
    
    private TableGrowthService growthService = new TableGrowthService();

    @Override
    public void contextInitialized(ServletContextEvent event) {
        
        scheduler = Executors.newSingleThreadScheduledExecutor();

        Runnable captureTask = new Runnable() {
            
            @Override
            public void run() {
                
                System.out.println("Starting automated dynamic table size capture...");
                
                Connection mysqlConn = null;
                PreparedStatement ps = null;
                ResultSet rs = null;
                
                // This map will group table names by their Target Database (e.g., MIDB -> [Table1, Table2])
                Map<String, List<String>> dbToTablesMap = new HashMap<String, List<String>>();
                
                // We assume all configured databases belong to the "PR" site for this loop
                String site = "PR"; 

                try {
                    
                    // 1. Ask MySQL which tables we need to track today
                    mysqlConn = databaseconnection.getMysqlConnection();
                    
                    String configSql = "SELECT target_db, table_name FROM tracker_config WHERE site = ?";
                    
                    ps = mysqlConn.prepareStatement(configSql);
                    ps.setString(1, site);
                    
                    rs = ps.executeQuery();

                    // Group the tables by database
                    while (rs.next()) {
                        
                        String targetDb = rs.getString("target_db");
                        String tableName = rs.getString("table_name");
                        
                        if (!dbToTablesMap.containsKey(targetDb)) {
                            dbToTablesMap.put(targetDb, new ArrayList<String>());
                        }
                        
                        dbToTablesMap.get(targetDb).add(tableName);
                    }
                    
                    // 2. Loop through each database and execute the Oracle capture
                    for (Map.Entry<String, List<String>> entry : dbToTablesMap.entrySet()) {
                        
                        String targetDb = entry.getKey();
                        List<String> tablesToTrack = entry.getValue();
                        
                        System.out.println("Capturing sizes for " + targetDb + "...");
                        
                        growthService.captureDailyTableSizes(site, targetDb, tablesToTrack);
                        
                    }

                    System.out.println("Automated table size capture complete.");

                } catch (Exception e) {
                    
                    System.err.println("Error running dynamic background capture.");
                    e.printStackTrace();
                    
                } finally {
                    
                    if (rs != null) {
                        try { rs.close(); } catch (Exception e) {}
                    }
                    
                    if (ps != null) {
                        try { ps.close(); } catch (Exception e) {}
                    }
                    
                    if (mysqlConn != null) {
                        try { databaseconnection.closeconnection(mysqlConn); } catch (Exception e) {}
                    }
                }
            }
        };

        // Run instantly on boot, then every 24 hours
        scheduler.scheduleAtFixedRate(captureTask, 0, 24, TimeUnit.HOURS);
        
    }

    @Override
    public void contextDestroyed(ServletContextEvent event) {
        
        if (scheduler != null) {
            scheduler.shutdownNow();
        }
        
    }
}
